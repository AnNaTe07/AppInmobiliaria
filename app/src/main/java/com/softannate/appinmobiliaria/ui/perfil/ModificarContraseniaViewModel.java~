package com.softannate.appinmobiliaria.ui.perfil;

import static androidx.core.content.ContextCompat.startActivity;

import android.app.Application;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.util.Log;
import android.widget.Toast;

import androidx.annotation.NonNull;
import androidx.lifecycle.AndroidViewModel;
import androidx.lifecycle.LiveData;
import androidx.lifecycle.MutableLiveData;
import androidx.lifecycle.ViewModel;

import com.softannate.appinmobiliaria.LoginActivity;
import com.softannate.appinmobiliaria.modelos.Pass;
import com.softannate.appinmobiliaria.modelos.Propietario;
import com.softannate.appinmobiliaria.request.ApiClient;

import java.io.IOException;

import okhttp3.ResponseBody;
import retrofit2.Call;
import retrofit2.Callback;
import retrofit2.Response;


public class ModificarContraseniaViewModel extends AndroidViewModel {

    private Context contexto;
    private MutableLiveData<Pass> mPass;
    private MutableLiveData<Boolean> redirigirAlLogin;

    public ModificarContraseniaViewModel(@NonNull Application application) {
        super(application);
        mPass = new MutableLiveData<Pass>();
        redirigirAlLogin = new MutableLiveData<>();
        contexto = application.getApplicationContext();
    }

    public LiveData<Pass> getMPass() {
        if (mPass == null) {
            mPass = new MutableLiveData<Pass>();
        }
        return mPass;
    }
    public LiveData<Boolean> getRedirigirAlLogin() {
        return redirigirAlLogin;
    }

    public void cambiarPass(String passActual, String nuevaPass, String confirmaPass) {
        if (!nuevaPass.equals(confirmaPass)) {
            mPass.setValue(null);
            Toast.makeText(getApplication(), "'Confirmar contraseña' y 'Nuevo Pass' deben coincidir.", Toast.LENGTH_SHORT).show();
            return; // sale si las contraseñas no coinciden
        }
        Pass pass = new Pass(passActual, nuevaPass);
        ApiClient.Endpoints api = ApiClient.getApi();
        String token = ApiClient.getToken(contexto);

        Call<ResponseBody> llamadaCambioPass = api.pass(token, pass);
        Log.d("Pass", "Actual: " + pass.getPassActual() + ", Nueva: " + pass.getNuevoPass());

        llamadaCambioPass.enqueue(new Callback<ResponseBody>() {
            @Override
            public void onResponse(Call<ResponseBody> call, Response<ResponseBody> response) {
                if (response.isSuccessful()) {
                    mPass.setValue(new Pass(passActual, nuevaPass)); // Indica que el cambio fue exitoso
                    //Log.d("salida cambiaPass", "Contraseña cambiada correctamente.");
                    Toast.makeText(getApplication(), "Password cambiado correctamente.", Toast.LENGTH_SHORT).show();
                    redirigirAlLogin.setValue(true);//redirijo al login al realizar el cambio
                } else {
                   // Log.d("Error", "Código de error: " + response.code());
                    Toast.makeText(getApplication(), "Error al intentar cambiar el Password.", Toast.LENGTH_SHORT).show();
                    try {
                        String errorBody = response.errorBody().string();
                        Log.d("Error", errorBody);
                    } catch (IOException e) {
                        e.printStackTrace();
                    }
                    mPass.setValue(null); // Indico error
                }
            }

            @Override
            public void onFailure(Call<ResponseBody> call, Throwable throwable) {
                Toast.makeText(getApplication(), "Error al cambiar Password", Toast.LENGTH_SHORT).show();
                //Log.d("fallocambiaPass", throwable.getMessage());
                mPass.setValue(null); // Indico error
                redirigirAlLogin.setValue(false);
            }
        });
    }
}