<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AppInmobiliaria" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="AppBarStyle">
        <item name="android:fontFamily">@font/aclonica</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="Theme.AppInmobiliaria.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Cambia el color del CheckBox -->
        <item name="colorControlActivated">#040D47</item>
    </style>
    <!--cambio la fuente del menu, aplico en activity_main:  app:itemTextAppearance="@style/NavItemText"-->
    <style name="NavItemText" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/aclonica</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Theme.AppInmobiliaria.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AppInmobiliaria.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>